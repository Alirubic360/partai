# Copy to .env and export. Never commit real keys.
PARTAI_MODE=demo            # demo | local | live
OPENAI_API_KEY=
SERPAPI_API_KEY=
GEMINI_API_KEY=          # free tier key
PARTAI_VISION=          # openai | gemini | local (empty = auto from keys)
PARTAI_GEMINI_MODEL=gemini-2.0-flash
PARTAI_VISION_MODEL=gpt-4o
PARTAI_DB_PATH=data/partai.db
PARTAI_FREE_MONTHLY_LIMIT=10
PARTAI_DEADLINE_SECONDS=15
